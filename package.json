{
  "name": "sky-doodle",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "homepage": "https://sky-doodle.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESeungJun/sky-doodle.git"
  },
  "scripts": {
